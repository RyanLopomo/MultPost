# Banco de dados
DATABASE_URL="file:./dev.db"

# JWT — troque por uma string aleatória longa em produção
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="TROQUE_POR_SEGREDO_FORTE_EM_PRODUCAO"
JWT_EXPIRES_IN="8h"

# Servidor
PORT=3333
NODE_ENV="development"
DEBUG_WHATSAPP_TEXT="false"

# Telegram Bot
TELEGRAM_BOT_TOKEN="SEU_TOKEN_AQUI"
TELEGRAM_CHAT_ID="SEU_CHAT_ID_AQUI"

# CORS — domínio do seu frontend
CORS_ORIGIN="http://localhost:5173"
