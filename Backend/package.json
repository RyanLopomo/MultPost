{
  "name": "multipost-backend",
  "version": "1.0.0",
  "description": "Backend robusto para sistema de postagem multicanal",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
